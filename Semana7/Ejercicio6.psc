Algoritmo Ejercicio6 
	
	// Solicitar dos números al usuario y mostrar la suma y la resta.
	
	Definir Numer1, numer2, Sumar, Restar Como Entero
	
	Escribir "Dame dos numeros para sumar y restar."
	Escribir "Digita el primer numero: "
	Leer Numer1
	
	Escribir "Digita el segundo numero: "
	Leer numer2
	
	Sumar = Numer1 + numer2
	
	Restar =  Numer1 - numer2
	
	Escribir "Resultados.. Suma: ", Sumar " Resta: ", Restar
	
FinAlgoritmo
