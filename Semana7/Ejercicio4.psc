Algoritmo Ejercicio4 
	
	// Crear un programa que reciba un número N y muestre
	// los primeros N números pares usando un bucle para. ( modulo Para ) 
	

	Definir Numer, i Como Entero
	
	Escribir "Digite un numero para conocer sus parejas,"
	Escribir  "digo digo pares .."
	Leer  Numer
	
    Para i <- 1 Hasta Numer Hacer
        Si i MOD 2 = 0 Entonces
            Escribir i
        FinSi
    FinPara
	
	Escribir "Estos son todos los pares posibles :>"
	
FinAlgoritmo
