Algoritmo Ejercicio7 
	
	// Solicitar dos números y mostrar el producto y el cociente.
	
	Definir Numer1, numer2, Producto, Cociente Como real
	
	Escribir "producto y cociente ^o^."
	Escribir "Digita el primer numero: "
	Leer Numer1
	
	Escribir "Digita el segundo numero: "
	Leer numer2
	
	Producto = Numer1 * numer2
	
	Cociente =  Numer1 / numer2
	
	Escribir "Resultados.. Producto: ", Producto " Cociente: ", Cociente
	
FinAlgoritmo
