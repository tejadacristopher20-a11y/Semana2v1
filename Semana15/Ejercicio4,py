# 4. Elaborar un programa que llene un arreglo con 8 números ingresados
# por el usuario y, mediante una función, determine cuál es el número mayor.


def numeroMayor(listaNumeros):
    mayor = listaNumeros[0]
    for numero in listaNumeros:
        if numero > mayor:
            mayor = numero
    return mayor


numeros = []

print("Ingresa 8 números:")

for i in range(8):
    numero = int(input(f"Ingrese el número {i+1}: "))
    numeros.append(numero)

mayor = numeroMayor(numeros)

print(f"\nEl número mayor es: {mayor}")
